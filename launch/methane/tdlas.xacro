<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    EDITING THIS FILE BY HAND IS NOT RECOMMENDED                                 | -->
<!-- =================================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tdlas">
  
  <xacro:arg name="frame_ns" default="tdlas"/>
  ### Define colors
  
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="lightgrey">
    <color rgba="0.8 0.8 0.8 1"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.0 0.0 1"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.9 0.0 1"/>
  </material>
  <material name="blue">
    <color rgba="0.41 0.83 0.96 1"/>
  </material>
  

  # Base
  <link name="$(arg frame_ns)_base_link">
    <visual>
      <geometry>
        <cylinder length="1.0" radius="0.15"/>
      </geometry>
      <material name="red"/>
      <origin xyz="0 0 0"/>
    </visual>
  </link>
    
   
  
  ## SENSORS ##  

  # PTU WXXMS Interbotix
  <xacro:include filename="$(find interbotix_xsturret_descriptions)/urdf/wxxms.urdf.xacro" />
  
  # Create a fixed joint to connect the BASE to the GPS
  <link name="gps_tdlas"/>
  <joint name="gps_to_base_joint" type="fixed">
    <parent link="gps_tdlas"/>
    <child link="$(arg frame_ns)_base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  # Create a fixed joint to connect the PTU to the base
  <joint name="base_to_ptu_joint" type="fixed">
    <parent link="$(arg frame_ns)_base_link"/>
    <child link="wxxms/base_link"/>
    <origin xyz="0.0 0.0 1.0" rpy="0 0 0"/>
  </joint>

  # Create a fixed joint to connect the RGB_camera to the PTU
  <link name="camera"/>
  <joint name="camera_to_ptu_surface" type="fixed">
    <parent link="wxxms/surface_link"/>
    <child link="camera"/>
    <!-- <origin xyz="0.07 0 0.0" rpy="-1.57079 0 -1.57079"/> -->
    <origin xyz="0.0 0.092 0.05" rpy="-1.57079 -1.57079 -1.57079"/>
  </joint>
 
</robot>